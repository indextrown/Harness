#!/usr/bin/env sh

set -eu

commit_msg_file="$1"
first_line="$(sed -n '1p' "$commit_msg_file")"

case "$first_line" in
  Merge\ *|Revert\ *)
    exit 0
    ;;
esac

pattern='^(feat|fix|chore|docs|refactor|test|style|perf|ci|build)(\([a-z0-9._/-]+\))?: [^[:space:]].+$'

if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

echo "커밋 메시지 형식이 올바르지 않습니다." >&2
echo "허용 형식: type: subject 또는 type(scope): subject" >&2
echo "예시: feat: add worktree bootstrap" >&2
echo "예시: chore(hooks): enforce commit message format" >&2
echo "허용 type: feat, fix, chore, docs, refactor, test, style, perf, ci, build" >&2
exit 1
